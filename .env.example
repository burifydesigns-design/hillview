# Hillview Physiotherapy Environment Variables
# Copy this file to .env.local and fill in your values

# Google Analytics 4 Measurement ID
# Get this from Google Analytics > Admin > Data Streams > Web Stream Details
GA4_MEASUREMENT_ID=

# Nookal Booking URL
# The full booking URL for the "Book an Appointment" buttons
# Format: https://book.nookal.com/bookings/book/YOUR_BOOKING_ID/location
NOOKAL_BOOKING_URL=https://book.nookal.com/bookings/book/ACB0861D-c3df-0dEE-09FD-016FBbfcca9d/location

# Site URL (for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://www.hillviewphysiogroup.com.au